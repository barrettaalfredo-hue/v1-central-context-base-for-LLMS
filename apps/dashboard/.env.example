# Tomt = fristående mock-läge (dashboardens egna /api-routes svarar).
# Satt = varje /api-anrop skickas vidare till Alfredos API på servern (lib/upstream.ts).
# Måndag: previewen för integration/v1, t.ex. https://<preview>.vercel.app
API_BASE_URL=

# Om Alfredos Vercel-preview har Deployment Protection påslaget: hemligheten från
# Vercel -> Settings -> Deployment Protection -> Protection Bypass for Automation.
# Annars svarar previewen med en HTML-inloggning och dashboarden visar UPSTREAM_NOT_JSON.
VERCEL_PROTECTION_BYPASS=

# Visas i anslutningsguiden. Tomt = API_BASE_URL + /api/mcp.
NEXT_PUBLIC_MCP_URL=

# Endast mock-läge. Lösenord för de tre mock-kontona
# (filip@example.com, alfredo@example.com, melker@example.com).
# Riktiga testkonton ägs av Alfredo och hör inte hemma här.
MOCK_PASSWORD=mock-losen
