# Tomt = fristående mock-läge (dashboardens egna /api-routes svarar).
# Satt = alla /api/* skickas vidare till Alfredos API. Ingen kod ändras.
# Exempel: https://<alfredos-preview>.vercel.app
API_BASE_URL=

# Visas i anslutningsguiden. Sätt till Alfredos /api/mcp.
NEXT_PUBLIC_MCP_URL=

# Endast mock-läge. Lösenord för de tre mock-kontona
# (filip@example.com, alfredo@example.com, melker@example.com).
# Riktiga testkonton ägs av Alfredo och hör inte hemma här.
MOCK_PASSWORD=mock-losen
